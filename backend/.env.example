# ============================================
# Variables de Entorno — Inventario Panadería
# ============================================
# COPIA este archivo como .env y completa los valores

# Base de datos PostgreSQL (Railway te da esta URL)
DATABASE_URL=postgresql+asyncpg://usuario:contraseña@host:5432/railway

# JWT Secret (genera uno seguro con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CAMBIAR-POR-CLAVE-SEGURA-DE-64-CARACTERES

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_NAME=Inventario Panadería
DEBUG=False
API_PREFIX=/api

# Frontend URL (poner la URL de Vercel cuando hagas deploy)
FRONTEND_URL=https://tu-inventario.vercel.app
